<%@page import="java.util.regex.Pattern"%>
<%!

public  boolean inValidFileExtension(String fileName) {
    String allowedExtensions = "exe|rar|zip|jsp|java|class";
    String regex = "([^\\s]+(\\.(?i)(" + allowedExtensions + "))$)";
    Pattern pattern = Pattern.compile(regex);
    Matcher matcher = pattern.matcher(fileName);
    return matcher.matches();
}
%>
